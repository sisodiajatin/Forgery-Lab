# Copy this file to .env and paste your keys after the = (no quotes needed)
REDUCTO_API_KEY=
PANGRAM_API_KEY=

# Modal account token (modal.com > Settings > API Tokens)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal Model API endpoint: DeepSeek V4.1 Flash 1017
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
DEEPSEEK_AUTH=
DEEPSEEK_MODAL_KEY=
DEEPSEEK_MODAL_SECRET=

GLMFLASH_BASE_URL=
GLMFLASH_MODEL=zai-org/GLM-5.3-Flash
GLMFLASH_AUTH=
GLMFLASH_MODAL_KEY=
GLMFLASH_MODAL_SECRET=

KIMI_BASE_URL=
KIMI_MODEL=moonshotai/Kimi-K3.1-Pro
KIMI_AUTH=
KIMI_MODAL_KEY=
KIMI_MODAL_SECRET=
